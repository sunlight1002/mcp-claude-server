# Shared MCP gateway
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_DOMAIN=mcp.claude.lee-associates-southflorida.com

# EnformionGO Developer API
# Docs: https://enformiongo.readme.io/reference/overview
ENFORMIONGO_API_URL=https://devapi.enformion.com
ENFORMIONGO_ACCESS_PROFILE_NAME=your-api-key-name
ENFORMIONGO_ACCESS_PROFILE_PASSWORD=your-api-key-password
# ENFORMIONGO_TIMEOUT=30

# ZoomInfo API
# Docs: https://api-docs.zoominfo.com/
ZOOMINFO_API_URL=https://api.zoominfo.com
ZOOMINFO_USERNAME=your-username
ZOOMINFO_PASSWORD=your-password
# Optional PKI auth (instead of username/password):
# ZOOMINFO_CLIENT_ID=your-client-id
# ZOOMINFO_PRIVATE_KEY=your-private-key
# ZOOMINFO_TIMEOUT=60

# Parcel scraper automation service
PARCELSCRAPER_API_URL=https://automation.lee-associates-southflorida.com
# Per-request HTTP timeout in seconds (default 120)
# PARCELSCRAPER_TIMEOUT=120
# Poll interval while waiting for jobs (default 5 seconds)
# PARCELSCRAPER_POLL_INTERVAL=5
# Max wait time for blocking scrape tools (default 1800 seconds / 30 min)
# PARCELSCRAPER_MAX_WAIT=1800
# Auto-detail byte budget before switching to summary output (default 500000)
# PARCELSCRAPER_MAX_RESULT_BYTES=500000

# Admin site Next.js API
ADMINSITE_API_URL=https://admin.lee-associates-southflorida.com
# Optional bearer token when API auth is enabled:
# ADMINSITE_API_KEY=your-api-key
# ADMINSITE_TIMEOUT=300
# Same Supabase project as florida_associate_admin (required for search_properties / get_property)
ADMINSITE_SUPABASE_URL=https://your-project.supabase.co
ADMINSITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
